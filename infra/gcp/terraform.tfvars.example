# PriceLens GCP Terraform example.
# Copy to terraform.tfvars for local use. terraform.tfvars is gitignored.
# Never place provider credential values in this file.

project_id = "replace-with-your-gcp-project-id"
region     = "europe-west3"

# Phase A: bootstrap shared infrastructure only.
deploy_runtime = false

# Optional one-time Phase-A bootstrap for keyless GitHub Actions image publishing.
# This trusts only the immutable mrAibo/PRICE_LENS repository identity on main.
# github_wif_image_publisher_enabled = true
# github_repository                  = "mrAibo/PRICE_LENS"
# github_repository_id               = "1401433983"
# github_repository_owner_id         = "93589172"
#
# Phase B: enable only after a real image has been pushed and a production
# API hostname has been selected.
#
# deploy_runtime = true
# api_domain     = "api.your-owned-domain.de"
# api_image      = "europe-west3-docker.pkg.dev/replace-with-your-gcp-project-id/price-lens/price-lens-api:0123456789abcdef0123456789abcdef01234567"
#
# The map contains Secret Manager VERSION NUMBERS only, never secret values.
# Add secret versions out-of-band, then pin them here.
#
# secret_versions = {
#   EBAY_CLIENT_ID                    = "1"
#   EBAY_CLIENT_SECRET                = "1"
#   AMAZON_CREATORS_CREDENTIAL_ID     = "1"
#   AMAZON_CREATORS_CREDENTIAL_SECRET = "1"
#   PRICE_LENS_SESSION_SIGNING_SECRET  = "1"
#   PRICE_LENS_GOOGLE_SUBJECT_TIERS_JSON = "1"
# }
#
# session_auth_enabled                   = false
# session_ttl_seconds                    = 900
# google_identity_verify_timeout_ms       = 3000
# auth_exchange_requests_per_interval     = 20
# ebay_browse_enabled                     = false
# ebay_marketplace_comparison_enabled  = false
# ebay_environment                      = "sandbox"
# ebay_delivery_country                 = "DE"
# ebay_marketplace_search_concurrency   = 3
# ebay_catalog_epid_fallback_enabled          = false
# ebay_catalog_brand_model_fallback_enabled   = false
# ebay_catalog_brand_model_candidate_limit    = 5
# ebay_catalog_brand_model_detail_concurrency = 2
# ebay_catalog_marketplace_id                 = "EBAY_DE"
# ebay_marketplace_detail_enrichment_enabled = false
# ebay_marketplace_detail_limit              = 5
# ebay_marketplace_detail_concurrency        = 2
# ebay_marketplace_search_ids = [
#   "EBAY_DE", "EBAY_PL", "EBAY_AT", "EBAY_FR",
#   "EBAY_IT", "EBAY_ES", "EBAY_NL", "EBAY_BE"
# ]
# ecb_fx_enabled           = false
# ecb_fx_cache_ttl_ms      = 21600000
# ecb_fx_max_rate_age_days = 7
# ecb_fx_timeout_ms        = 2000
# amazon_creators_enabled              = false
# amazon_marketplace_search_concurrency = 2
# amazon_marketplace_partner_tags = {
#   "www.amazon.de" = "replace-after-approved-de-access"
#   # "www.amazon.pl" = "replace-after-approved-pl-access"
# }
# Legacy single-market fallback:
# amazon_partner_tag = "replace-only-after-approved-live-access"

# Keep the first edge-rate-limit rule in preview until traffic is measured.
cloud_armor_rate_limit_preview = true

# Runtime observability resources are created with Phase B by default.
# Alert policies themselves stay disabled until the public DNS/TLS endpoint is live.
operational_monitoring_enabled  = true
monitoring_alerts_enabled       = false
operational_log_retention_days  = 30

# Reuse approved Cloud Monitoring notification channels. Do not commit email,
# webhook, PagerDuty, Slack, or other recipient configuration here.
#
# monitoring_notification_channels = [
#   "projects/replace-with-your-gcp-project-id/notificationChannels/1234567890"
# ]
#
# Tune only after live traffic has been measured.
server_busy_rejections_threshold = 5
# cloud_run_5xx_requests_threshold = 5
# cloud_run_p95_latency_ms         = 5000
