# PriceLens GCP Terraform example.
# Copy to terraform.tfvars for local use. terraform.tfvars is gitignored.
# Never place provider credential values in this file.

project_id = "replace-with-your-gcp-project-id"
region     = "europe-west3"

# Phase A: bootstrap shared infrastructure only.
deploy_runtime = false

# Phase B: enable only after a real image has been pushed and a production
# API hostname has been selected.
#
# deploy_runtime = true
# api_domain     = "api.example.com"
# api_image      = "europe-west3-docker.pkg.dev/replace-with-your-gcp-project-id/price-lens/price-lens-api:replace-with-git-sha"
#
# The map contains Secret Manager VERSION NUMBERS only, never secret values.
# Add secret versions out-of-band, then pin them here.
#
# secret_versions = {
#   EBAY_CLIENT_ID                    = "1"
#   EBAY_CLIENT_SECRET                = "1"
#   AMAZON_CREATORS_CREDENTIAL_ID     = "1"
#   AMAZON_CREATORS_CREDENTIAL_SECRET = "1"
# }
#
# ebay_browse_enabled   = false
# ebay_environment      = "sandbox"
# amazon_creators_enabled = false
# amazon_partner_tag      = "replace-only-after-approved-live-access"

# Keep the first edge-rate-limit rule in preview until traffic is measured.
cloud_armor_rate_limit_preview = true
