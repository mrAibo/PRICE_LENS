# PriceLens local development configuration example.
# Do not commit real credentials. The application reads these values from the
# process environment; this file is documentation only.

# Build-time browser-extension API origin. Public builds require HTTPS.
# The default remains http://127.0.0.1:8787 for local development.
PRICE_LENS_API_ORIGIN=http://127.0.0.1:8787

PRICE_LENS_FIXTURE_PROVIDER=0
# Optional privacy-minimized JSON diagnostics to stdout.
PRICE_LENS_JSON_LOGS=0

# Official eBay Browse API enrichment.
# Keep disabled until Sandbox/Production credentials are available.
EBAY_BROWSE_ENABLED=0
EBAY_ENVIRONMENT=sandbox
EBAY_MARKETPLACE_ID=EBAY_DE
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Product-data caching is disabled until provider freshness rules are approved.
EBAY_BROWSE_CACHE_TTL_MS=0

# Amazon Creators API (Amazon.de PartnerNet / Associates).
# Shipping charges are not available in OffersV2, so Amazon landed prices stay
# incomplete until another permitted source can establish mandatory shipping.
AMAZON_CREATORS_ENABLED=0
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.de
# Product/price caching is disabled until Amazon account rules are validated.
AMAZON_CREATORS_CACHE_TTL_MS=0
