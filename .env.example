# PriceLens local development configuration example.
# Do not commit real credentials. The application reads these values from the
# process environment; this file is documentation only.

# Build-time browser-extension API origin. Public builds require HTTPS.
# The default remains http://127.0.0.1:8787 for local development.
PRICE_LENS_API_ORIGIN=http://127.0.0.1:8787

# API listener. Local development defaults remain 127.0.0.1:8787.
# The production Docker image sets HOST=0.0.0.0 and PORT=8080; Cloud Run
# supplies PORT at runtime.
HOST=127.0.0.1
PORT=8787

PRICE_LENS_FIXTURE_PROVIDER=0
# Optional privacy-minimized JSON diagnostics to stdout.
PRICE_LENS_JSON_LOGS=0
# When JSON diagnostics are enabled, emit a cumulative metrics_snapshot after
# this many diagnostic events. Metrics are process-local; persistence belongs
# to the deployment log/metrics backend.
PRICE_LENS_METRICS_EVERY=100
# Hard overload protection. Comparison requests above the first limit receive 503;
# each configured price provider is independently capped by the second limit.
PRICE_LENS_MAX_CONCURRENT_COMPARISONS=16
PRICE_LENS_PROVIDER_MAX_CONCURRENCY=4

# Official eBay Browse API enrichment.
# Keep disabled until Sandbox/Production credentials are available.
EBAY_BROWSE_ENABLED=0
EBAY_ENVIRONMENT=sandbox
EBAY_MARKETPLACE_ID=EBAY_DE
# Optional same-product eBay marketplace comparison. Requires Browse enrichment
# credentials and is intentionally opt-in until live API/compliance validation.
EBAY_MARKETPLACE_COMPARISON_ENABLED=0
# On an explicit report click, query these EU marketplaces with bounded fan-out.
EBAY_MARKETPLACE_SEARCH_IDS=EBAY_DE,EBAY_PL,EBAY_AT,EBAY_FR,EBAY_IT,EBAY_ES,EBAY_NL,EBAY_BE
# Buyer destination used for eBay shipping eligibility/context. Postal code will
# become an explicit user preference in a later Phase 3C slice.
EBAY_DELIVERY_COUNTRY=DE
EBAY_MARKETPLACE_SEARCH_CONCURRENCY=3
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Product-data caching is disabled until provider freshness rules are approved.
EBAY_BROWSE_CACHE_TTL_MS=0

# Amazon Creators API (Amazon.de PartnerNet / Associates).
# Shipping charges are not available in OffersV2, so Amazon landed prices stay
# incomplete until another permitted source can establish mandatory shipping.
AMAZON_CREATORS_ENABLED=0
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=3.2
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.de
# Product/price caching is disabled until Amazon account rules are validated.
AMAZON_CREATORS_CACHE_TTL_MS=0
